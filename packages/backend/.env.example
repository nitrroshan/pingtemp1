# ─────────────────────────────────────────────────────────────────────────────
# @ping/backend — Environment Configuration
# Copy this file to .env and fill in your values.
# Required variables must be set before the server will start.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (REQUIRED) ──────────────────────────────────────────────────────
# MongoDB connection string
# Dev (local Docker):   mongodb://localhost:27017/ping
# Dev (cloud Atlas):    mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ping
MONGODB_URI=mongodb://localhost:27017/ping

# ─── Azure OpenAI (REQUIRED) ──────────────────────────────────────────────────
# Your Azure OpenAI endpoint — e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT_URL=
# Azure OpenAI API key
AZURE_OPENAI_API_KEY=
# Azure OpenAI resource name (the sub-domain, e.g. "my-resource")
AZURE_OPENAI_INSTANCE_NAME=

# ─── Azure OpenAI (optional, with defaults) ───────────────────────────────────
# Default deployment name used for chat completions (default: gpt-4o-2)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-2
# API version (default: 2025-01-01-preview)
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ─── API Server (optional) ────────────────────────────────────────────────────
# Port for the backend HTTP/Socket.IO server (default: 3002)
# API_PORT=3002

# ─── Workspace (optional) ─────────────────────────────────────────────────────
# Base directory where per-team Git workspaces are stored (default: ./data/workspaces)
# WORKSPACE_BASE_DIR=./data/workspaces

# ─── Agent Runtime (optional) ─────────────────────────────────────────────────
# Which agent runtime to use: "aisdk" (default) | "langgraph"
# AGENT_RUNTIME=aisdk

# ─── Feature Flags (optional) ─────────────────────────────────────────────────
# Enable orchestrator mode for multi-task planning (default: true)
# USE_ORCHESTRATOR=true
# Seed database on startup — set to true during first-run setup (default: false)
# SEED_ENABLED=false
