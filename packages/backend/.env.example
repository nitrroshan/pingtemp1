# ============================================================
# Ping Backend — Environment Variables
# Copy to .env and fill in required values
# ============================================================

# --- Required: MongoDB ---
MONGODB_URI=mongodb://localhost:27017/ping

# --- Required: Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT_URL=https://your-instance.openai.azure.com/
AZURE_OPENAI_INSTANCE_NAME=your-instance

# --- Optional: Azure OpenAI model deployment ---
AZURE_OPENAI_DEPLOYMENT=gpt-4o-2
# AZURE_OPENAI_API_DEPLOYMENT_NAME=       # alias for AZURE_OPENAI_DEPLOYMENT

# --- Optional: Azure OpenAI Embeddings (for skill search) ---
# AZURE_OPENAI_EMBEDDINGS_ENDPOINT_URL=
# AZURE_OPENAI_EMBEDDINGS_API_KEY=
# AZURE_OPENAI_EMBEDDINGS_INSTANCE_NAME=

# --- Optional: Alternative LLM Providers ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Server ---
API_PORT=3002
NODE_ENV=development

# --- Feature Flags ---
USE_ORCHESTRATOR=true          # Set to "false" to disable orchestrator planning
USE_API_V2=true                # Set to "false" to disable V2 API routes

# --- Agent Runtime ---
# WORKSPACE_BASE_DIR=./data/workspaces
# COLLAB_PORT=1234
# AGENTS_DIR=                   # Custom path to YAML agent definitions