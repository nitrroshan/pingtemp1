# ─────────────────────────────────────────────────────────────────────────────
# Ping — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string
# Dev (local Docker):   mongodb://localhost:27017/ping
# Dev (cloud):          mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ping
MONGODB_URI=mongodb://localhost:27017/ping

# ─── Azure OpenAI ─────────────────────────────────────────────────────────────
# Your Azure OpenAI endpoint — e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT_URL=
# Azure OpenAI API key
AZURE_OPENAI_API_KEY=
# Azure OpenAI resource name (the sub-domain, e.g. "my-resource")
AZURE_OPENAI_INSTANCE_NAME=
# Default deployment name used for chat completions
AZURE_OPENAI_DEPLOYMENT=gpt-4o-2
# API version (e.g. 2025-01-01-preview)
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ─── API Server ───────────────────────────────────────────────────────────────
# Port for the backend HTTP/Socket.IO server
API_PORT=3002

# ─── Workspace ────────────────────────────────────────────────────────────────
# Base directory where per-team Git workspaces are stored
WORKSPACE_BASE_DIR=./data/workspaces

# ─── Collaboration (L2 — Hocuspocus CRDT) ────────────────────────────────────
# Port for the Hocuspocus WebSocket server (defaults to 1234)
# COLLAB_PORT=1234

# ─── Agent Runtime ────────────────────────────────────────────────────────────
# Which agent runtime to use: "aisdk" (default) | "langgraph"
AGENT_RUNTIME=aisdk

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Enable orchestrator mode (multi-task planning)
USE_ORCHESTRATOR=true
# Seed database on startup (set to true during first-run setup)
# SEED_ENABLED=false

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Backend API URL used by the frontend dev server proxy and client
VITE_API_URL=http://localhost:3002
