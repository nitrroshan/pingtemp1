{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server (TypeScript)",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch"],
      "args": ["${workspaceFolder}/src/worker/server.ts"],
      "cwd": "${workspaceFolder}/src/worker",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "NODE_ENV": "development"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server (Compiled JS)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/dist/src/worker/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "npm: build - src/worker",
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug AgentManager",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch"],
      "args": ["${workspaceFolder}/src/worker/agentManager/agentManager.ts"],
      "cwd": "${workspaceFolder}/src/worker",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "npm: build - src/worker"
    },
    {
      "command": "yarn build && yarn debug",
      "name": "Build & Debug in Terminal",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/src/worker"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}\\index.ts",
      "outFiles": ["${workspaceFolder}/**/*.js"]
    }
  ]
}
