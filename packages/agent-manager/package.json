{
  "name": "@ping/agent-manager",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const s='src/agent/agents';const d='dist/agent/agents';fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).filter(f=>f.endsWith('.yaml')).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.65",
    "@ai-sdk/azure": "^3.0.50",
    "@ai-sdk/openai": "^3.0.49",
    "@langchain/core": "^1.1.0",
    "ai": "^6.0.143",
    "dotenv": "^16.5.0",
    "tslog": "^4.10.2",
    "yaml": "^2.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
