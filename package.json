{
  "name": "ping",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d && bun run dev:backend & bun run dev:frontend",
    "dev:backend": "bun run --filter @ping/backend dev",
    "dev:frontend": "bun run --filter @ping/frontend dev",
    "build:backend": "bun run --filter @ping/backend build",
    "build:frontend": "bun run --filter @ping/frontend build",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "mongo:start": "docker run -d --name ping-mongo -p 27017:27017 -v ping-mongo-data:/data/db mongo:7",
    "mongo:stop": "docker stop ping-mongo",
    "mongo:rm": "docker rm ping-mongo",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "seed": "bun run --filter @ping/backend seed",
    "db:reset": "bun run --filter @ping/backend db:reset",
    "desktop": "bun run --filter @ping/desktop dev",
    "desktop:build": "bun run build:frontend && bun run --filter @ping/desktop build",
    "desktop:make": "bun run build:frontend && cd packages/desktop && node scripts/copy-frontend.js && tsc && cd ../.. && npx electron-packager packages/desktop Ping --platform=win32 --arch=x64 --out=packages/desktop/out --overwrite --icon=packages/desktop/resources/icons/win/icon.ico --no-prune --ignore=\"(src|scripts|tsconfig|\\.gitignore|forge)\"",
    "desktop:publish": "bun run build:frontend && bun run --filter @ping/desktop publish",
    "postinstall": "node scripts/fix-bun-links.js"
  },
  "dependencies": {
    "motion-dom": "^12.38.0",
    "motion-utils": "^12.36.0",
    "pino": "^10.3.1",
    "react-router": "^7.14.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "y-protocols": "^1.0.7"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
