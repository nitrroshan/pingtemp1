# ============================================================
# Ping Backend — Environment Variables
# Copy to .env and fill in required values
# ============================================================

# --- Deployment Mode ---
# local  = all file-based (lowdb JSON + SQLite auth, no external deps)
# cloud  = MongoDB for chat + auth, cloud storage for plugins
# hybrid = PostgreSQL for relational data, MongoDB for chat (production recommended)
PING_MODE=local

# --- PostgreSQL (required when PING_MODE=hybrid) ---
# Local dev: postgresql://ping:ping@localhost:5432/ping
# Neon: postgresql://...@ep-xxx.neon.tech/ping?sslmode=require
# DATABASE_URL=postgresql://ping:ping@localhost:5432/ping

# --- MongoDB (used when PING_MODE=cloud or hybrid) ---
# MONGODB_URI=mongodb://localhost:27017/ping
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ping?retryWrites=true&w=majority
# For Azure Cosmos DB (vCore):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/ping?tls=true&authMechanism=SCRAM-SHA-256

# --- Required: Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT_URL=https://your-instance.openai.azure.com/
AZURE_OPENAI_INSTANCE_NAME=your-instance

# --- Optional: Azure OpenAI model deployment ---
AZURE_OPENAI_DEPLOYMENT=gpt-4o-2
# AZURE_OPENAI_API_DEPLOYMENT_NAME=       # alias for AZURE_OPENAI_DEPLOYMENT

# --- Optional: Azure OpenAI Embeddings (for skill search) ---
# AZURE_OPENAI_EMBEDDINGS_ENDPOINT_URL=
# AZURE_OPENAI_EMBEDDINGS_API_KEY=
# AZURE_OPENAI_EMBEDDINGS_INSTANCE_NAME=

# --- Optional: Alternative LLM Providers ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Server ---
API_PORT=3002
NODE_ENV=development
# LOG_LEVEL=info                   # trace, debug, info, warn, error, fatal

# --- Auth (better-auth) ---
# BETTER_AUTH_SECRET=              # Required in production. Auto-generated in dev if missing.
# BETTER_AUTH_URL=http://localhost:3002  # Base URL for auth callbacks

# --- GitHub OAuth (for repo browser + clone/push auth) ---
# Create a GitHub OAuth App: https://github.com/settings/developers
# Set callback URL to: http://localhost:3002/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Feature Flags ---
USE_ORCHESTRATOR=true          # Set to "false" to disable orchestrator planning
USE_API_V2=true                # Set to "false" to disable V2 API routes
# FF_PLANNER_MODE=orchestrator   # "orchestrator" | "direct"
# FF_ENABLE_COST_TRACKING=false  # Enable LLM cost tracking
# FF_ENABLE_KNOWLEDGE_BASE=true  # Enable knowledge base features
# FF_ENABLE_COLLAB_EDITOR=true   # Enable collaborative editor UI
# FF_ENABLE_GIT_PUSH=false       # Enable workspace git push

# --- Agent Runtime ---
# WORKSPACE_BASE_DIR=./data/workspaces
# COLLAB_PORT=1234
# COLLAB_MODE=embedded             # "embedded" (dev, in-process) or "external" (prod, separate container)
# COLLAB_URL=ws://localhost:1234   # WebSocket URL when COLLAB_MODE=external
# STORAGE_TYPE=fs                  # "fs" (local), "azure" (Azure Blob), "s3" (AWS S3)
# AZURE_STORAGE_CONNECTION_STRING= # Required when STORAGE_TYPE=azure
# AZURE_STORAGE_CONTAINER=ping-data # Azure Blob container name
# AGENTS_DIR=                   # Custom path to YAML agent definitions